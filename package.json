{
  "name": "baru-gastronomia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:firebase": "npm run build",
    "check:production": "node scripts/check-production-env.mjs",
    "deploy:firebase": "npm run check:production && npx firebase deploy --only firestore:rules,firestore:indexes",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components lib shared tests scripts vitest.config.ts vite.config.ts",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --exclude tests/firestore.rules.test.ts",
    "test:domain": "vitest run --config vitest.config.ts tests/baru-domain.test.ts tests/baru-data.test.ts tests/order-domain.test.ts",
    "test:rules": "node scripts/test-rules.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/admin.spec.ts",
    "audit": "node scripts/audit.mjs",
    "emulators": "firebase emulators:start --project demo-baru-gastronomia --import=.firebase-data --export-on-exit=.firebase-data",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@types/qrcode": "^1.5.6",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "firebase": "^12.18.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.55.0",
    "@cloudflare/workers-types": "5.20260917.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "firebase-tools": "^15.28.2",
    "jsdom": "^30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "4.134.0"
  },
  "type": "module"
}
