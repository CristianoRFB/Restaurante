{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baru-gastronomia",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "dist/server/index.js",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
